@article{Deng2007a,
abstract = {Cancer cells exhibit many abnormal phenotypes that induce apoptotic signaling via the intrinsic, or mitochondrial, pathway. That cancer cells nonetheless survive implies that they select for blocks in apoptosis. Identifying cancer-specific apoptotic blocks is necessary to rationally target them. Using a panel of 18 lymphoma cell lines, we show that a strategy we have developed, BH3 profiling, can identify apoptotic defects in cancer cells and separate them into three main classes based on position in the apoptotic pathway. BH3 profiling identifies cells that require BCL-2 for survival and predicts sensitivity to the BCL-2 antagonist ABT-737. BCL-2 dependence correlates with high levels of proapoptotic BIM sequestered by BCL-2. Strikingly, BH3 profiling can also predict sensitivity to conventional chemotherapeutic agents like etoposide, vincristine, and adriamycin. {\textcopyright} 2007 Elsevier Inc. All rights reserved.},
author = {Deng, Jing and Carlson, Nicole and Takeyama, Kunihiko and {Dal Cin}, Paola and Shipp, Margaret and Letai, Anthony},
doi = {10.1016/j.ccr.2007.07.001},
file = {:Users/simon/Documents/Mendeley Desktop/Deng et al. - 2007 - BH3 Profiling Identifies Three Distinct Classes of Apoptotic Blocks to Predict Response to ABT-737 and Conventional.pdf:pdf},
isbn = {1535-6108 (Print)$\backslash$r1535-6108 (Linking)},
issn = {15356108},
journal = {Cancer Cell},
keywords = {CELLCYCLE},
number = {2},
pages = {171--185},
pmid = {17692808},
title = {{BH3 Profiling Identifies Three Distinct Classes of Apoptotic Blocks to Predict Response to ABT-737 and Conventional Chemotherapeutic Agents}},
volume = {12},
year = {2007}
}
@article{Muchmore1996,
abstract = {THE Bcl-2 family of proteins regulate programmed cell death by an unknown mechanism. Here we describe the crystal and solution structures of a Bcl-2 family member, Bcl-xL (ref. 2). The structures consist of two central, primarily hydrophobic alpha-helices, which are surrounded by amphipathic helices. A 60-residue loop connecting helices alpha1 and alpha2 was found to be flexible and non-essential for anti-apoptotic activity. The three functionally important Bcl-2 homology regions (BH1, BH2 and BH3) are in close spatial proximity and form an elongated hydrophobic cleft that may represent the binding site for other Bcl-2 family members. The arrangement of the alpha-helices in Bcl-xL is reminiscent of the membrane translocation domain of bacterial toxins, in particular diphtheria toxin and the colicins. The structural similarity may provide a clue to the mechanism of action of the Bcl-2 family of proteins.},
archivePrefix = {arXiv},
arxivId = {Nature 381, 335–341},
author = {Muchmore, Steven W. and Sattler, Michael and Liang, Heng and Meadows, Robert P. and Harlan, John E. and Yoon, Ho Sup and Nettesheim, David and Chang, Brian S. and Thompson, Craig B. and Wong, Sui-Lam and Ng, Shi-Chung and Fesik, Stephen W.},
doi = {10.1038/381335a0},
eprint = {Nature 381, 335–341},
file = {:Users/simon/Documents/Mendeley Desktop/Muchmore et al. - 1996 - X-ray and NMR structure of human Bcl-xL, an inhibitor of programmed cell death.pdf:pdf},
isbn = {0028-0836},
issn = {0028-0836},
journal = {Nature},
number = {6580},
pages = {335--341},
pmid = {8692274},
title = {{X-ray and NMR structure of human Bcl-xL, an inhibitor of programmed cell death}},
