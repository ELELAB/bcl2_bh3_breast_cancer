@article{Edlich2017,
abstract = {Proteins of the B-cell lymphoma-2 (BCL-2) family control the intrinsic apoptosis pathway. The pro-apoptotic BCL-2 proteins BAX and BAK can commit a cell to its programmed death by permeabilizing the outer mitochondrial membrane (OMM) and subsequent initiation of the caspase cascade. Therefore, the activities of BAX and BAK are precisely controlled by a complex network of proteins inside and outside the BCL-2 family. Cells survive by constant control of dynamic translocation and retrotranslocation of BAX and BAK to the mitochondria and back into the cytosol. Recent insights into BAX/BAK shuttling, BCL-2 protein interactions, the role of BH3-only proteins in apoptosis signaling and the active BAX complex set the stage for the development of novel strategies in cancer therapy and the analysis of cellular predisposition to apoptosis.},
author = {Edlich, Frank},
doi = {10.1016/j.bbrc.2017.06.190},
file = {:Users/simon/Documents/Mendeley Desktop/Edlich - 2017 - BCL-2 proteins and apoptosis Recent insights and unknowns.pdf:pdf},
issn = {10902104},
journal = {Biochemical and Biophysical Research Communications},
keywords = {BCL-2 proteins,BH3-only proteins,Mitochondrial apoptosis,Retrotranslocation},
publisher = {Elsevier Ltd},
title = {{BCL-2 proteins and apoptosis: Recent insights and unknowns}},
year = {2017}
}
