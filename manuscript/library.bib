file = {:Users/simon/Documents/Mendeley Desktop/Leek et al. - 2010 - Tackling the widespread and critical impact of batch effects in high-throughput data.pdf:pdf},
isbn = {1471-0064 (Electronic)$\backslash$r1471-0056 (Linking)},
issn = {14710056},
journal = {Nature Reviews Genetics},
number = {10},
pages = {733--739},
pmid = {20838408},
publisher = {Nature Publishing Group},
title = {{Tackling the widespread and critical impact of batch effects in high-throughput data}},
url = {http://dx.doi.org/10.1038/nrg2825},
volume = {11},
year = {2010}
}
@article{Um2015,
abstract = {Although Bcl-2 family proteins were originally identified as key regulators of apoptosis, an impressive body of evidence has shown that pro-survival members of the Bcl-2 family, including Bcl-2, Bcl-XL , and Bcl-w, can also promote cell migration, invasion, and cancer metastasis. Interestingly, cell invasion was recently found to be suppressed by multidomain pro-apoptotic members of the Bcl-2 family, such as Bax and Bak. While the mechanisms underlying these new functions of Bcl-2 proteins are just beginning to be studied, reactive oxygen species (ROS) have emerged as inducers of cell invasion and the production of ROS from mitochondrial respiration is known to be promoted and suppressed by the pro-survival and multidomain pro-apoptotic Bcl-2 family members, respectively. Here, I review the evidence supporting the ability of Bcl-2 proteins to regulate cancer cell invasion and metastasis, and discuss our current understanding of their underlying mechanisms, with a particular focus on mitochondrial respiration and ROS, which could have implications for the development of strategies to overcome tumor progression},
author = {Um, Hong-Duck},
doi = {10.18632/oncotarget.6405},
file = {:Users/simon/Documents/Mendeley Desktop/Um - 2015 - Bcl-2 family proteins as regulators of cancer cell invasion and metastasis a review focusing on mitochondrial respiration a.pdf:pdf},
issn = {19492553},
journal = {Oncotarget},
keywords = {2015,accepted,august 13,bcl-2 family,cancer invasion and metastasis,mitochondrial respiration,november 21,november 26,published,reactive oxygen species,received},
number = {5},
pages = {5193--5203},
pmid = {26621844},
title = {{Bcl-2 family proteins as regulators of cancer cell invasion and metastasis : a review focusing on mitochondrial respiration and reactive oxygen species}},
volume = {7},
year = {2015}
}
