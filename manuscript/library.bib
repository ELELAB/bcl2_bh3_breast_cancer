@article{Law2016,
abstract = {The ability to easily and efficiently analyse RNA-sequencing data is a key strength of the Bioconductor project. Starting with counts summarised at the gene-level, a typical analysis involves pre-processing, exploratory data analysis, differential expression testing and pathway analysis with the results obtained informing future experiments and validation studies. In this workflow article, we analyse RNA-sequencing data from the mouse mammary gland, demonstrating use of the popular edgeR package to import, organise, filter and normalise the data, followed by the limma package with its voom method, linear modelling and empirical Bayes moderation to assess differential expression and perform gene set testing. This pipeline is further enhanced by the Glimma package which enables interactive exploration of the results so that individual samples and genes can be examined by the user. The complete analysis offered by these three packages highlights the ease with which researchers can turn the raw counts from an RNA-sequencing experiment into biological insights using Bioconductor.},
archivePrefix = {arXiv},
arxivId = {NIHMS150003},
author = {Law, Charity W. and Alhamdoosh, Monther and Su, Shian and Smyth, Gordon K. and Ritchie, Matthew E.},
doi = {10.12688/f1000research.9005.2},
eprint = {NIHMS150003},
file = {:Users/simon/Documents/Mendeley Desktop/Law et al. - 2016 - RNA-seq analysis is easy as 1-2-3 with limma, Glimma and edgeR.pdf:pdf},
isbn = {2046-1402 (Electronic)$\backslash$r2046-1402 (Linking)},
issn = {2046-1402},
journal = {F1000Research},
number = {1},
pages = {1408},
pmid = {27441086},
title = {{RNA-seq analysis is easy as 1-2-3 with limma, Glimma and edgeR}},
url = {https://f1000research.com/articles/5-1408/v2},
volume = {5},
year = {2016}
}
@article{Aouacheria2013,
abstract = {Bcl-2 family proteins regulate apoptosis in animals. This protein family includes several homologous proteins and a collection of other proteins lacking sequence similarity except for a Bcl-2 homology (BH)3 motif. Thus, membership in the Bcl-2 family requires only one of the four BH motifs. On this basis, a growing number of diverse BH3-only proteins are being reported. Although compelling cell biological and biophysical evidence validates many BH3-only proteins, claims of significant BH3 sequence similarity are often unfounded. Computational and phylogenetic analyses suggest that only some BH3 motifs arose by divergent evolution from a common ancestor (homology), whereas others arose by convergent evolution or random coincidence (homoplasy), challenging current assumptions about which proteins constitute the extended Bcl-2 family. {\textcopyright} 2012 Elsevier Ltd.},
archivePrefix = {arXiv},
arxivId = {NIHMS150003},
author = {Aouacheria, Abdel and {Rech de Laval}, Valentine and Combet, Christophe and Hardwick, J. Marie},
doi = {10.1016/j.tcb.2012.10.010},
eprint = {NIHMS150003},
file = {:Users/simon/Documents/Mendeley Desktop/Aouacheria et al. - 2013 - Evolution of Bcl-2 homology motifs Homology versus homoplasy.pdf:pdf},
isbn = {1110301197},
issn = {09628924},
journal = {Trends in Cell Biology},
keywords = {Apoptosis,BH3,Bcl-2 family,Evolution,Protein homology,Sequence motifs},
number = {3},
pages = {103--111},
pmid = {23199982},
publisher = {Elsevier Ltd},
title = {{Evolution of Bcl-2 homology motifs: Homology versus homoplasy}},
url = {http://dx.doi.org/10.1016/j.tcb.2012.10.010},
volume = {23},
year = {2013}
}
