keywords = {*DNA, Neoplasm,*Gene Expression,Algorithms,Breast Neoplasms/classification/*genetics,Carcinoma in Situ/classification/*genetics,Carcinoma, Ductal, Breast/classification/*genetics,Carcinoma, Lobular/classification/*genetics,Female,Fibroadenoma/classification/*genetics,Gene Expression Profiling,Humans,Oligonucleotide Array Sequence Analysis/methods,Tumor Suppressor Protein p53/genetics},
