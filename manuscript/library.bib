file = {:Users/simon/Documents/Mendeley Desktop/Czabotar et al. - 2007 - Structural insights into the degradation of Mcl-1 induced by BH3 domains.pdf:pdf},
isbn = {0027-8424 (Print)$\backslash$r0027-8424 (Linking)},
