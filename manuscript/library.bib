file = {:Users/simon/Documents/Mendeley Desktop/Nygaard et al. - 2016 - The Mutational Landscape of the Oncogenic MZF1 SCAN Domain in Cancer.pdf:pdf},
issn = {2296-889X},
journal = {Frontiers in Molecular Biosciences},
keywords = {cancer mutations,foldx,molecular dynamics,protein structure network,rnaseq,saturation mutagenesis,tcga,transcription factors,transcription factors, molecular dynamics, protein},
number = {December},
pages = {1--18},
